{
  "multipart": [
    {
      "apply": [
        {
          "model": "tintedsoil:block/tinted_dirt"
        },
        {
          "model": "tintedsoil:block/tinted_dirt",
          "y": 90
        },
        {
          "model": "tintedsoil:block/tinted_dirt",
          "y": 180
        },
        {
          "model": "tintedsoil:block/tinted_dirt",
          "y": 270
        }
      ]
    },
    {
      "when": {
        "soil_type": "podzol"
      },
      "apply": {
        "model": "tintedsoil:block/tinted_podzol_overlay"
      }
    }
  ]
}
