{
  "multipart": [
    {
      "when": {
        "snowy": "false"
      },
      "apply": [
        {
          "model": "tintedsoil:block/tinted_grass_block"
        },
        {
          "model": "tintedsoil:block/tinted_grass_block",
          "y": 90
        },
        {
          "model": "tintedsoil:block/tinted_grass_block",
          "y": 180
        },
        {
          "model": "tintedsoil:block/tinted_grass_block",
          "y": 270
        }
      ]
    },
    {
      "when": {
        "snowy": "false"
      },
      "apply": {
        "model": "tintedsoil:block/tinted_grass_block_overlay"
      }
    },
    {
      "when": {
        "snowy": "true"
      },
      "apply": {
        "model": "tintedsoil:block/tinted_grass_block_snow"
      }
    }
  ]
}
