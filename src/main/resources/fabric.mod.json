{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Retints vanilla and worldgen-mod soil in place -- dirt, coarse dirt, podzol and grass blocks -- so soil blends smoothly across biome and soil borders instead of cutting off hard. Adds no blocks and changes no world data.",
  "authors": [
    "minerguy341"
  ],
  "contact": {
    "sources": "https://github.com/minerguy341/Tinted-Soil",
    "issues": "https://github.com/minerguy341/Tinted-Soil/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.minerguy341.tintedsoil.TintedSoilFabric"
    ],
    "client": [
      "com.minerguy341.tintedsoil.client.TintedSoilFabricClient"
    ]
  },
  "mixins": [
    "tintedsoil.mixins.json",
    {
      "config": "tintedsoil.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15",
    "minecraft": "${minecraft}"
  }
}
